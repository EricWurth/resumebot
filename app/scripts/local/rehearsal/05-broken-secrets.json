{
  "name": "broken-secrets",
  "tier": "fast",
  "plan": 5,
  "about": "A cut-short and an empty secret are replaced, the restart note is said, and the doors are repaired.",
  "steps": [
    {
      "run": {
        "expect_rc": 0
      }
    },
    {
      "op": "file",
      "path": "{data}/secrets/owner-token",
      "text": "abc"
    },
    {
      "op": "file",
      "path": "{data}/secrets/wake-secret",
      "text": ""
    },
    {
      "run": {
        "expect_rc": 0
      }
    },
    {
      "check": "secrets",
      "whole": 4
    },
    {
      "check": "text",
      "path": "{data}/install/install.log",
      "has": [
        "restart the app so it reads them"
      ]
    },
    {
      "check": "door",
      "name": "resumebot-owner",
      "url": "{app}/mcp-owner/",
      "token": "owner-token"
    },
    {
      "check": "door",
      "name": "resumebot-browser",
      "url": "{engine}/mcp-browser/",
      "token": "browser-token"
    }
  ]
}
